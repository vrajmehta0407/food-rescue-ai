# Environment Configuration for FoodRescue AI
PROJECT_NAME="FoodRescue AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# For local dev without Docker, uses SQLite fallback: sqlite:///./foodrescue.db
# For Docker/PostgreSQL: postgresql+psycopg2://foodrescue:rescue_secure_pass@localhost:5432/foodrescue_db
DATABASE_URL=sqlite:///./foodrescue.db

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Model Configuration
ML_MODEL_PATH=ml/artifacts/surplus_model.joblib
ML_METRICS_PATH=ml/artifacts/metrics.json

# Demo Mode
DEMO_MODE=True

